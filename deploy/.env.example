# UEnvision production settings.
# Copy this file to /home/uenvision/uenvision-capstone/.env on the server and
# fill it in. Never commit the real .env file (it is in .gitignore).
# Write values without quotes or spaces around the = sign.

# Must be 0 on the live server.
DJANGO_DEBUG=0

# A long random string. Generate one on the server with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Comma-separated host names the site answers to (no http://, no slashes).
# Add your domain here later, e.g. 201.18.219.201,uenvision.example.com,www.uenvision.example.com
DJANGO_ALLOWED_HOSTS=201.18.219.201

# Comma-separated full origins (with http:// or https://) that forms are posted from.
# After HTTPS is set up, change these to https://yourdomain and https://www.yourdomain
DJANGO_CSRF_TRUSTED_ORIGINS=http://201.18.219.201

# Set to 1 only AFTER certbot has HTTPS working on your domain. It makes cookies
# HTTPS-only and redirects http:// to https://.
DJANGO_HTTPS=0
# Once HTTPS has worked for a few days you can raise this (e.g. 31536000 = 1 year).
DJANGO_HSTS_SECONDS=3600

# Where collectstatic puts CSS/JS/images for nginx to serve.
DJANGO_STATIC_ROOT=/var/www/uenvision/static

# Optional: Gemini API keys, comma-separated. These are used together with any
# keys saved in api_keys.txt from the Data > Extract Skills page. You can leave
# this empty and keep using api_keys.txt only.
GEMINI_API_KEYS=

# Email for account confirmation links (Hostinger mailbox).
# Leave EMAIL_HOST empty to turn emails off: new accounts then log in without confirming.
# Use a mailbox password without $ # & ; " ' ` \ or spaces (this file is read by bash).
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_HOST_USER=noreply@uenvision.tech
EMAIL_HOST_PASSWORD=
